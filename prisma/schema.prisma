// Prisma schema — AppQLDA Web (Quản lý dự án kết cấu thép)
// DB: PostgreSQL (Supabase) cho prod; trước đây SQLite (dev).
// Các trường "enum" vẫn lưu String (giữ tương thích, đơn giản hóa migrate),
// giá trị hợp lệ + nhãn định nghĩa ở src/lib/constants.ts (validate bằng Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SALES") // ADMIN | SALES | ENGINEERING | PROCUREMENT | ACCOUNTING
  active       Boolean  @default(true)
  // Tăng lên mỗi khi cần vô hiệu hóa mọi phiên đang mở của user
  // (đổi mật khẩu, đổi vai trò, khóa tài khoản). Token cũ mang version cũ -> bị từ chối.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectMemberships ProjectMember[]
}

// Gán người dùng ↔ dự án (scope theo dự án được giao). ADMIN không cần gán (thấy tất cả).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  address       String?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  clientQuotes  ClientQuote[]
  notes         CustomerNote[]
  khachHang     KhachHang[]
}

// ----- CRM: khách đang chào giá -----

// Khách đang trao đổi, CHƯA ký hợp đồng.
//
// Khác Customer (chủ đầu tư) một cách có chủ ý: Customer là pháp nhân đã ký, cần MST,
// địa chỉ pháp lý, người đại diện — những thứ mãi tới lúc lên hợp đồng mới có. Lúc mới
// gọi điện chỉ biết một người ở một công ty, ép khai đủ ngay là ép sai chỗ.
//
// Khi ký hợp đồng, `customerId` được nối tới CĐT mới tạo HOẶC một CĐT đã có sẵn — đó
// là chỗ chống nhập trùng một công ty thành hai bản ghi không biết nhau.
model KhachHang {
  id          String  @id @default(cuid())
  tenCty      String // "Công ty CP ABC", hoặc chỉ tên người nếu mới chỉ biết tới đó
  nguoiLienHe String?
  phone       String?
  email       String?
  diaChi      String?
  nguon       String? // giới thiệu | website | goi_den | trien_lam | khac

  // Phân quyền của CRM đi theo NGƯỜI PHỤ TRÁCH, không qua ProjectMember (chưa có dự
  // án nào để gán). Để trống = chưa phân công, ai có quyền xem CĐT đều thấy.
  ownerId   String?
  ownerName String? // chụp lại lúc tạo, sống sót khi tài khoản bị xóa

  // Điền khi đã ký hợp đồng và chuyển sang bên quản lý dự án.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traoDoi CustomerNote[]
  coHoi   CoHoi[]

  @@index([ownerId])
  @@index([customerId])
}

// Một công trình đang chào giá cho một khách. Đứng TRƯỚC dự án.
//
// Cố ý KHÔNG có mã duy nhất kiểu Project.code: chào giá mười nơi trúng một thì chín mã
// kia là rác, mà Project.code lại @unique nên xóa đi mới dùng lại được.
//
// Vì sao cần thực thể này chứ không treo báo giá thẳng vào khách: suy đơn giá m² đọc
// `area` làm mẫu số và `buildingType` để chọn sẵn mẫu báo giá. Không có chỗ giữ hai thứ
// đó thì phép suy gãy.
model CoHoi {
  id          String    @id @default(cuid())
  khachHangId String
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id], onDelete: Cascade)

  tenCongTrinh String // "Nhà xưởng Hồng Ngự" — chưa phải tên dự án chính thức
  diaDiem      String?
  buildingType String? // khớp Project.buildingType -> chọn sẵn mẫu báo giá
  area         Float? // m2 — mẫu số khi suy đơn giá m²
  kK           Float?
  kL           Float?
  kH           Float?

  trangThai String  @default("MOI") // MOI|DANG_CHAO|DAM_PHAN|KY_HD|MAT
  lyDoMat   String?

  // Điền khi đã ký hợp đồng và chuyển sang dự án. Cũng là dấu "cơ hội này đã xong".
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes       Quote[]
  clientQuotes ClientQuote[]

  @@index([khachHangId])
  @@index([trangThai])
}

// Nhật ký trao đổi với chủ đầu tư — cùng hình dạng ProjectNote, nhưng gắn với CĐT
// và (tùy chọn) một báo giá cụ thể. Đây là phần "CRM" của báo giá: ai đã gọi, nói
// gì, hẹn liên hệ lại lúc nào.
model CustomerNote {
  id String @id @default(cuid())

  // Ghi chép thuộc về MỘT trong hai: khách đang chào giá (CRM), hoặc chủ đầu tư đã ký.
  // Cả hai đều nullable vì một ghi chép chỉ treo ở một phía; ràng buộc "đúng một" được
  // ép ở tầng action, không bằng CHECK constraint (Prisma không sinh ra được).
  khachHangId String?
  khachHang   KhachHang? @relation(fields: [khachHangId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Xóa báo giá KHÔNG được xóa lịch sử liên hệ — cuộc gọi đã xảy ra thì vẫn đã xảy ra.
  clientQuoteId String?
  clientQuote   ClientQuote? @relation(fields: [clientQuoteId], references: [id], onDelete: SetNull)

  kind        String   @default("KHAC") // GOI|GAP|EMAIL|ZALO|KHAC
  contactDate DateTime @default(now())
  content     String

  // Tham chiếu MỀM tới tài khoản, cùng lý lẽ với AuditLog: nhật ký phải sống sót
  // khi tài khoản bị xóa. Tên được chụp lại lúc ghi.
  authorId   String?
  authorName String?

  nextFollowUpDate DateTime? // hẹn liên hệ lại -> vào bản tin nhắc việc hằng ngày
  createdAt        DateTime  @default(now())

  @@index([customerId, contactDate])
  @@index([khachHangId, contactDate])
  @@index([clientQuoteId])
  @@index([nextFollowUpDate])
}

model Supplier {
  id             String             @id @default(cuid())
  name           String
  category       String             @default("KHAC") // KCT|XA_GO|TON|BL_NEO|BLLK|LAP_DUNG|KHAC
  contactPerson  String?
  phone          String?
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  projectLinks   ProjectSupplier[]
  khuVucLinks    NhaCungCapKhuVuc[]
  giaMuaVatTu    GiaMuaVatTu[]
  estimateItems  EstimateItem[]
  purchaseOrders PurchaseOrder[]
}

model Project {
  id           String    @id @default(cuid())
  code         String    @unique // N037...
  name         String // K25L60
  buildingType String? // Xưởng, Nhà xưởng...
  status       String    @default("CHO") // CHO|SHOP|GIA_CONG|LAP_DUNG|HOAN_THANH
  location     String?
  // Khu vực thi công — quyết định mua của nhóm nhà cung cấp nào, và do đó đơn giá
  // nào được gợi ý. Cột "location" text tự do ở trên giữ nguyên: nó là địa chỉ, không
  // phải phân vùng, và 124 dòng cũ không ép chuẩn hoá được.
  khuVucId     String?
  khuVuc       KhuVuc?   @relation(fields: [khuVucId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  startDate    DateTime?
  endDate      DateTime?
  kK           Float? // bước khung K
  kL           Float? // chiều dài L
  kH           Float? // chiều cao H
  area         Float? // m2
  salePrice    Float? // giá bán / hợp đồng
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  suppliers        ProjectSupplier[]
  milestones       Milestone[]
  weeklyLogs       WeeklyLog[]
  progressNotes    ProjectNote[]
  docVersions      DocVersion[]
  proposals        Proposal[]
  payments         Payment[]
  takeoffItems     TakeoffItem[]
  estimateItems    EstimateItem[]
  estimateSections EstimateSection[]
  contracts        Contract[]
  purchaseOrders   PurchaseOrder[]
  costSummary      CostSummary?
  quotes           Quote[]
  clientQuotes     ClientQuote[]
  members          ProjectMember[]
  coHoi            CoHoi? // cơ hội chào giá đã sinh ra dự án này (nếu có)

  @@index([status])
  @@index([customerId])
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderNo      String? // số/tên đơn
  orderDate    DateTime?
  category     String // KCT | XA_GO | TON | VTP
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status       String    @default("DRAFT") // DRAFT | ORDERED | RECEIVED
  orderedDate  DateTime?
  expectedDate DateTime? // dự kiến giao
  receivedDate DateTime?
  value        Float? // Σ thành tiền
  totalWeight  Float? // Σ trọng lượng (kg)
  filePath     String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items PurchaseOrderItem[]

  @@index([projectId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category  String? // loại sheet: BLLK, Tôn mái, Diềm...
  groupName String? // hạng mục: HM Khung mái...
  name      String
  unit      String?
  qty       Float?
  unitPrice Float?
  amount    Float?
  weight    Float? // kg
  note      String?
  sortOrder Int           @default(0)

  images PoItemImage[]

  @@index([orderId])
}

model PoItemImage {
  id        String            @id @default(cuid())
  itemId    String
  item      PurchaseOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mime      String            @default("image/png")
  data      Bytes // ảnh biên dạng nhúng từ file đơn
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([itemId])
}

model Contract {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractNo     String? // Số HĐ: 0704/2026/HĐMB...
  signDate       DateTime? // ngày ký
  subject        String? // V/v: cung cấp & thi công nhà thép...
  partyAName     String? // Bên A (CĐT)
  partyAInfo     String? // địa chỉ, MST, người đại diện
  valueBeforeVat Float? // giá trị chưa VAT = Σ hạng mục
  vatPercent     Float?    @default(8)
  valueWithVat   Float? // tổng có VAT
  paymentTerms   String? // các đợt thanh toán
  filePath       String? // đường dẫn file HĐ đã ký
  status         String    @default("QUOTE") // QUOTE | SIGNED | LIQUIDATED
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items ContractItem[]

  @@index([projectId])
}

model ContractItem {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String // hạng mục: Khung mái, Vách, Panel...
  unit       String? // m2
  qty        Float? // khối lượng / diện tích
  unitPrice  Float? // đơn giá bán
  amount     Float? // thành tiền
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([contractId])
}

model ProjectSupplier {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  component  String // KCT|XA_GO|TON|BL_NEO|BLLK|LAP_DUNG

  @@unique([projectId, component])
  @@index([supplierId])
}

model Milestone {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // BV_KT|SHOP|MUA_HANG|GIA_CONG|LAP_DUNG|LOP_TON|HS_NT|HS_QT
  planDate   DateTime?
  actualDate DateTime?
  done       Boolean   @default(false)
  note       String?

  @@unique([projectId, type])
}

model WeeklyLog {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year           Int
  week           Int
  statusSnapshot String?
  note           String?

  @@unique([projectId, year, week])
}

model ProjectNote {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content    String
  authorName String?
  createdAt  DateTime    @default(now())
  images     NoteImage[]

  @@index([projectId, createdAt])
}

// Ảnh đính kèm ghi chú (lưu trên Supabase Storage, chỉ giữ key).
model NoteImage {
  id        String      @id @default(cuid())
  noteId    String
  note      ProjectNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  key       String // đường dẫn trong bucket
  mime      String      @default("image/jpeg")
  createdAt DateTime    @default(now())
}

model DocVersion {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType    String // BAO_GIA | HOP_DONG | SHOP_DRAWING
  version    String // R0, R1, v1...
  issuedAt   DateTime? // ngày phát hành / gửi
  status     String    @default("DRAFT") // DRAFT | SENT | APPROVED | SUPERSEDED
  note       String?
  authorName String?
  createdAt  DateTime  @default(now())

  @@index([projectId, docType, createdAt])
}

// Đề xuất & phê duyệt online (mua hàng, thanh toán...).
model Proposal {
  id           String    @id @default(cuid())
  title        String
  kind         String    @default("MUA_HANG") // MUA_HANG | THANH_TOAN | KHAC
  amount       Float?
  content      String?
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdBy    String
  decidedBy    String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

// Thanh toán theo đợt: THU (từ CĐT) / CHI (cho NCC, thầu phụ).
model Payment {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction   String // THU | CHI
  counterpart String? // tên CĐT / NCC
  name        String // Tạm ứng, Đợt 1, Quyết toán...
  amount      Float? // số tiền theo kế hoạch
  dueDate     DateTime? // hạn thu / hạn trả
  paidDate    DateTime? // ngày thực thu / thực trả
  paidAmount  Float? // số tiền thực tế
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, direction])
  @@index([direction, dueDate])
}

// Bóc tách khối lượng: cấu kiện bê tông (móng/cột/dầm/sàn/vách/lanh tô) & thép (hình/tổ hợp/bản mã).
model TakeoffItem {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String // BT | THEP_HINH | TO_HOP | BAN_MA
  group      String? // BT: FD|CL|FR|FL|WA|LT
  code       String? // FD1, C1, DK1...
  name       String
  spec       String? // mã thép hình hoặc mô tả tổ hợp
  dims       String? // JSON kích thước nhập
  qty        Float    @default(1)
  concrete   Float? // m3
  formwork   Float? // m2
  rebarRatio Float? // kg/m3
  rebar      Float? // kg
  steel      Float? // kg thép hình / tổ hợp / bản mã
  note       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, kind])
}

model EstimateItem {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId      String? // Hạng mục (Khung mái, Vách...) — null = chưa phân
  section        EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  groupLabel     String? // Nhóm cấp 2 (Bulong neo, Máng nước...) hiển thị theo mẫu
  groupCode      String // KCT|XA_GO|TON|BL_NEO|BLLK|VT_PHU|NHAN_CONG|VAN_CHUYEN|MAY|KHAC
  name           String
  unit           String?
  designQty      Float?
  actualQty      Float?
  unitPrice      Float?
  amount         Float?
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderStatus    String? // Đặt hàng
  dispatchStatus String? // Xuất hàng
  note           String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())

  // ----- Xuất xứ khi dòng được đổ xuống từ dự toán chào giá -----
  //
  // Cả ba đều nullable: 516 dòng nhập từ Excel không đến từ thư viện nào, và dòng gõ
  // tay cũng vậy.
  congTacId   String?
  congTac     CongTac?       @relation(fields: [congTacId], references: [id], onDelete: SetNull)
  donGiaId    String?
  donGiaNguon DonGiaCongTac? @relation(fields: [donGiaId], references: [id], onDelete: SetNull)
  // Vùng đang được tính giá LÚC LẬP — khác với khu vực ghi trên bản giá đã dùng. Lập
  // cho Tây Ninh nhưng phải dùng giá chung toàn quốc (khuVucId của bản giá là null) là
  // chuyện thường; chỉ cột này mới kể lại được.
  khuVucId    String?
  khuVuc      KhuVuc?        @relation(fields: [khuVucId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@index([projectId])
  @@index([supplierId])
  @@index([congTacId])
}

// ----- Mẫu hạng mục dự toán (Khung mái, Vách, Canopy, Nóc gió, Dầm sàn...) -----
model EstimateTemplate {
  id          String                 @id @default(cuid())
  name        String // "Khung mái"
  code        String? // "A"
  description String?
  sortOrder   Int                    @default(0)
  active      Boolean                @default(true)
  lines       EstimateTemplateLine[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model EstimateTemplateLine {
  id               String           @id @default(cuid())
  templateId       String
  template         EstimateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  groupLabel       String // Nhóm cấp 2: "Bulong neo", "Kết cấu thép"...
  name             String // "Thép tổ hợp"
  unit             String?
  defaultUnitPrice Float?
  role             String // INPUT | DERIVED
  feedsParam       String? // INPUT: nạp KL vào tham số này
  takesFromParam   String? // DERIVED: KL = param × factor
  factor           Float?           @default(1)
  defaultQty       Float?
  groupCode        String // map ESTIMATE_GROUP cho bảng lợi nhuận theo nhóm
  note             String?
  sortOrder        Int              @default(0)

  @@index([templateId])
}

// ----- Hạng mục thực trong 1 dự án (sinh khi áp mẫu) -----
model EstimateSection {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String // "Khung mái"
  code       String? // "A"
  templateId String? // nguồn mẫu (tham chiếu, không FK cứng)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  items      EstimateItem[]

  @@index([projectId])
}

// ----- Tổng hợp chi phí (quyết toán thực tế) -----
model CostSummary {
  id               String         @id @default(cuid())
  projectId        String         @unique
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revenue          Float? // Doanh Thu
  cost             Float? // Chi phí
  profit           Float? // LNTT
  extraVat         Float? // VAT được nhận thêm
  paidWithVat      Float? // Đã Chi cả V
  collectedWithVat Float? // Đã Thu cả V
  receivable       Float? // Còn Phải thu
  collectionNote   String? // vd "đã thu đủ"
  filePath         String? // đường dẫn file THCP gốc
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  categories       CostCategory[]
}

model CostCategory {
  id        String      @id @default(cuid())
  summaryId String
  summary   CostSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  code      String // A..K
  groupCode String // map ESTIMATE_GROUP: KCT|XA_GO|TON|...
  name      String
  supplier  String? // NCC
  value     Float? // GIÁ TRỊ
  payment   Float? // THANH TOÁN
  invoice   Float? // HÓA ĐƠN
  sortOrder Int         @default(0)
  items     CostItem[]

  @@index([summaryId])
}

model CostItem {
  id         String       @id @default(cuid())
  categoryId String
  category   CostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String // Hạng Mục
  qty        Float? // Khối lượng
  unitPrice  Float? // Đơn giá
  amount     Float? // Thành tiền
  ref        String? // Thời gian / HĐ
  note       String? // Ghi chú
  sortOrder  Int          @default(0)

  @@index([categoryId])
}

// ----- Đơn giá & Báo giá chi tiết (Mã CV) -----

// Bảng danh mục công việc & đơn giá dùng chung mọi dự án (sheet DV).
model WorkPrice {
  id           String   @id @default(cuid())
  code         String   @unique // Mã CV: AA.110
  name         String // nội dung công việc (ND)
  shortName    String? // Loại
  spec         String? // TSKT
  unit         String? // đơn vị
  groupCode    String   @default("AA") // AA..AL (2 ký tự đầu mã)
  material     Float? // VT (vật tư)
  laborMachine Float? // NC_M (nhân công + máy)
  coefficient  Float? // HS (hệ số)
  baseCost     Float? // GT = (material + laborMachine) * coefficient
  note         String? // GC
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Báo giá chi tiết của 1 dự án (mỗi dự án có thể nhiều bản).
// Dự toán chi tiết theo Mã CV. Sống được ở HAI nơi, và chỉ một trong hai:
//   · cơ hội chào giá — giai đoạn đang báo giá, chưa có hợp đồng nào;
//   · dự án — sau khi ký hợp đồng, bản dự toán theo sang dự án.
// Cố ý KHÔNG cho cả hai cùng có giá trị: chủ sở hữu quyết định ai được xem/sửa, hai chủ
// cùng lúc nghĩa là hai luật quyền chồng nhau. Vết "cơ hội nào thành dự án nào" đã nằm ở
// CoHoi.projectId, không cần giữ thêm ở đây.
model Quote {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coHoiId      String?
  coHoi        CoHoi?    @relation(fields: [coHoiId], references: [id], onDelete: Cascade)
  title        String // tiêu đề/phiên bản
  recipient    String? // Kính gửi
  location     String? // Địa điểm
  // Khu vực dùng để tra đơn giá. Có cột RIÊNG chứ không đọc qua Project: một bản dự
  // toán sống được ở CoHoi, lúc đó chưa có dự án nào để hỏi. Tạo từ dự án thì lấy mặc
  // định từ Project.khuVucId.
  khuVucId     String?
  khuVuc       KhuVuc?   @relation(fields: [khuVucId], references: [id], onDelete: SetNull)
  scope        String? // Hạng mục
  quoteDate    DateTime?
  markup       Float?    @default(1) // hệ số TL: đơn giá bán = giá gốc × markup
  clonedFromId String? // bản gốc đã clone
  clonedFrom   Quote?    @relation("QuoteClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       Quote[]   @relation("QuoteClone")
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sections     QuoteSection[]
  items        QuoteItem[]
  clientQuotes ClientQuote[]  @relation("QuoteToClient")

  @@index([projectId])
  @@index([coHoiId])
}

// Phần (A/B/…) và mục con (I/II) — cây 2 cấp qua parentId.
model QuoteSection {
  id        String         @id @default(cuid())
  quoteId   String
  quote     Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  code      String // A / B / I / II
  name      String
  kind      String         @default("PHAN") // PHAN | SUB
  parentId  String?
  parent    QuoteSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  QuoteSection[] @relation("SectionTree")
  area      Float? // m2 (cho phần)
  sortOrder Int            @default(0)

  items QuoteItem[]

  @@index([quoteId])
  @@index([parentId])
}

// Dòng vật tư trong báo giá.
model QuoteItem {
  id        String       @id @default(cuid())
  quoteId   String
  quote     Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sectionId String
  section   QuoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  workCode  String? // tham chiếu MỀM tới CongTac.ma (có thể tự nhập)
  name      String
  unit      String?
  qty       Float? // khối lượng
  baseCost  Float? // giá gốc (snapshot, override được)
  sellPrice Float? // đơn giá bán = baseCost × markup (override được)
  spec      String? // quy cách
  note      String?
  sortOrder Int          @default(0)

  // ----- Đóng băng giá thư viện -----
  //
  // Dòng báo giá CHỤP LẠI đơn giá tại thời điểm lập. Thư viện đổi giá không bao giờ
  // tự sửa một báo giá đã lập — người lập thấy huy hiệu lệch giá và tự quyết có cập
  // nhật hay không. Mọi cột dưới đây đều nullable: 72 dòng cũ và những dòng gõ tay
  // hoàn toàn không có gì để chụp.
  congTacId      String?
  congTac        CongTac?       @relation(fields: [congTacId], references: [id], onDelete: SetNull)
  congTacVatTuId String?
  bienThe        CongTacVatTu?  @relation(fields: [congTacVatTuId], references: [id], onDelete: SetNull)
  // ĐÚNG bản giá đã dùng. Đây mới là ảnh chụp thật; `donGiaThuVien` chỉ là con số
  // tiện tra, còn cái này nói được "lấy từ bản giá nào, hiệu lực từ ngày nào".
  donGiaId       String?
  donGiaNguon    DonGiaCongTac? @relation(fields: [donGiaId], references: [id], onDelete: SetNull)
  // Giá thư viện LÚC CHỐT. Khác `baseCost` khi người dùng sửa tay.
  donGiaThuVien  Float?
  chotGiaLuc     DateTime?
  // Gương của ClientQuoteLine.priceOverridden: người dùng đã đè giá, nên "Cập nhật
  // giá từ thư viện" phải bỏ qua dòng này.
  giaSuaTay      Boolean        @default(false)

  @@index([quoteId])
  @@index([sectionId])
  @@index([congTacId])
}

// ----- Báo giá gửi khách (theo hạng mục, đơn vị m²) -----

// Khác báo giá chi tiết (Mã CV) ở chỗ: đây là VĂN BẢN gửi ra ngoài — có số, có
// trạng thái, có hiệu lực, có VAT và điều khoản. Báo giá chi tiết là bảng tính giá
// thành nội bộ.
//
// Cố ý TÁCH hai bảng chứ không thêm cột `kind` vào Quote: hiện có 5 chỗ cộng tiền
// trên MỌI Quote trong phạm vi mà không lọc gì (trang /quotes, trang dự án lấy
// quotes[0] mới nhất, danh sách trong trình soạn, nguồn clone, pushSalePrice).
// Gộp chung thì một bản m² vừa tạo sẽ thành "báo giá mới nhất" và hiện 0 đ trên
// dashboard dự án. Tách bảng làm lỗi đó không thể xảy ra.
model ClientQuote {
  id        String   @id @default(cuid())
  // Cùng luật một chủ như Quote: bản gửi khách sống ở cơ hội lúc còn chào giá, theo
  // sang dự án khi ký hợp đồng. Xem chú thích ở model Quote.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coHoiId   String?
  coHoi     CoHoi?   @relation(fields: [coHoiId], references: [id], onDelete: Cascade)

  quoteNo   String? // Số báo giá: BG-2026-014 (tự nhập)
  title     String // tiêu đề/phiên bản nội bộ
  quoteDate DateTime?

  // --- Bên nhận ---
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipient     String? // "Kính gửi" — chụp lại tên lúc lập, để bản in không đổi khi CĐT đổi tên
  customerPhone String?
  location      String?
  scope         String? // "Kết cấu thép và bao che"

  // --- Người phụ trách (khối liên hệ trang 1) ---
  salesName  String?
  salesPhone String?
  salesEmail String?

  // --- Vòng đời ---
  status     String    @default("NHAP") // NHAP|DA_GUI|DAM_PHAN|CHOT|HUY
  sentDate   DateTime?
  validDays  Int?      @default(7) // hiệu lực báo giá
  expiryDate DateTime? // = quoteDate + validDays; chốt cứng khi bấm "Đã gửi"

  // --- Thuế & điều khoản có cấu trúc ---
  vatPercent        Float? @default(10)
  warrantyMonths    Int?   @default(12) // bảo hành
  maintenanceMonths Int?   @default(120) // bảo trì phần kết cấu thép
  loadRoof          Float? // hoạt tải mái (kg/m2)
  loadHanging       Float? // tải treo    (kg/m2)
  loadFloor         Float? // tải sàn     (kg/m2)

  // --- Đoạn chữ in ra (đè giá trị mẫu; để trống = dùng mẫu) ---
  // Mô tả chung áp cho MỌI hạng mục — các gạch đầu dòng dưới tên đầu việc. Trong
  // báo giá mẫu hai dòng này lặp y hệt ở cả 4 hạng mục, nên để một chỗ rồi dùng
  // chung; dòng nào cần khác thì tự điền ClientQuoteLine.detail để đè lên.
  lineDetail  String?
  greeting    String? // hai đoạn mở đầu
  closing     String? // "Chân thành cảm ơn sự hợp tác của Quý khách hàng."
  colorNote   String? // ghi chú 2 — màu sắc
  volumeNote  String? // ghi chú 3 — khối lượng tạm tính
  excludeNote String? // ghi chú 9 — không bao gồm thí nghiệm

  templateId    String? // mẫu đã dùng (tham chiếu MỀM: xóa mẫu không được xóa báo giá)
  derivedFromId String? // báo giá chi tiết đã sinh ra bản này
  derivedFrom   Quote?        @relation("QuoteToClient", fields: [derivedFromId], references: [id], onDelete: SetNull)
  clonedFromId  String?
  clonedFrom    ClientQuote?  @relation("ClientQuoteClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones        ClientQuote[] @relation("ClientQuoteClone")

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    ClientQuoteLine[]
  specs    ClientQuoteSpec[]
  stages   ClientQuoteStage[]
  payments ClientQuotePayment[]
  contacts CustomerNote[]

  @@index([projectId])
  @@index([coHoiId])
  @@index([customerId])
  @@index([status, expiryDate]) // nguồn cho nhắc việc hằng ngày
}

// Dòng hạng mục — mỗi dòng thường là một đơn giá m² trọn gói.
model ClientQuoteLine {
  id      String      @id @default(cuid())
  quoteId String
  quote   ClientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  partCode  String  @default("I") // I, II… gom nhóm khi in
  partName  String  @default("Phần kết cấu thép")
  code      String? // "01"
  name      String // "Gia công sản xuất, lắp dựng khung nhà thép mác Q235..."
  detail    String? // các gạch đầu dòng, mỗi dòng một ý
  unit      String? @default("m2")
  qty       Float? // tổng khối lượng
  unitPrice Float?
  // Để TRỐNG = thành tiền tính bằng qty × unitPrice. Điền = chốt cứng (dòng khoán,
  // vd "Cửa đẩy chớp bằng tôn KT 1.0*3.0m (6 cái)").
  amount    Float?
  note      String? // Ghi chú / Quy cách

  // --- vết sinh tự động ---
  // Hạng mục này dùng những loại vật tư nào (xem VAT_TU_TAG). Bảng vật liệu ở
  // mục 2 chỉ in dòng có nhãn thuộc một hạng mục đang có.
  tags            String[]
  sourceSectionId String? // phần nào của báo giá chi tiết đã sinh ra đơn giá này
  priceOverridden Boolean  @default(false) // true = người dùng sửa tay; "Tính lại" bỏ qua dòng này
  steelFrameKey   String? // khóa hạng mục bên SteelFrame để rót khối lượng (xem plan/30)

  sortOrder Int @default(0)

  @@index([quoteId])
}

// Bảng "Vật liệu áp dụng và thông số kỹ thuật" — nhóm A (kết cấu thép), B (tôn & bao che).
model ClientQuoteSpec {
  id            String      @id @default(cuid())
  quoteId       String
  quote         ClientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  groupCode     String      @default("A") // A | B
  // Loại vật tư (VAT_TU_TAG). Để TRỐNG = vật tư dùng chung, luôn in.
  tag           String?
  name          String // "Thép tấm tổ hợp"
  spec          String? // "fy = 2.450 kG/cm2"
  origin        String? // cột "Ghi chú và xuất xứ"
  // Có nhắc lại dòng này trong mô tả dưới tên hạng mục không. Mặc định KHÔNG:
  // bảng vật liệu ở mục 2 đã kể đủ, nhắc lại tất cả thì hạng mục mái phải gánh 7
  // gạch đầu dòng trong khi báo giá thật chỉ nêu đúng loại tôn.
  inDescription Boolean     @default(false)
  sortOrder     Int         @default(0)

  @@index([quoteId])
}

// Tiến độ thi công (ghi chú 4) — tổng số ngày = Σ days.
model ClientQuoteStage {
  id        String      @id @default(cuid())
  quoteId   String
  quote     ClientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String // "Gia công cấu kiện"
  days      Int?
  sortOrder Int         @default(0)

  @@index([quoteId])
}

// Tiến độ thanh toán (ghi chú 8) — Σ percent phải bằng 100.
model ClientQuotePayment {
  id        String      @id @default(cuid())
  quoteId   String
  quote     ClientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label     String // "Sau khi kí hợp đồng"
  percent   Float? // 30
  basis     String? // "GTHĐ" | "Quyết toán"
  note      String? // "kí hợp đồng" / "thư bảo lãnh 5%"
  sortOrder Int         @default(0)

  @@index([quoteId])
}

// ----- Thư viện mẫu báo giá gửi khách -----

// Quản trị viên soạn một lần theo LOẠI CÔNG TRÌNH (khớp Project.buildingType), bộ
// phận kinh doanh chọn khi lập báo giá. Cùng ý tưởng với EstimateTemplate nhưng KHÔNG
// dùng chung: mẫu dự toán mô tả khối lượng vật tư để tính giá thành nội bộ, mẫu này
// mô tả một VĂN BẢN gửi ra ngoài (lời chào, điều khoản, bảng vật liệu).
//
// ClientQuote.templateId là tham chiếu MỀM tới bảng này — xóa mẫu không được kéo theo
// báo giá đã phát hành.
model QuoteTemplate {
  id           String  @id @default(cuid())
  name         String // "Nhà xưởng kết cấu thép + bao che"
  buildingType String? // khớp Project.buildingType; so khớp bỏ dấu/hoa thường
  description  String?
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  // --- giá trị mặc định rót vào báo giá mới ---
  vatPercent        Float? @default(10)
  validDays         Int?   @default(7)
  warrantyMonths    Int?   @default(12)
  maintenanceMonths Int?   @default(120)
  loadRoof          Float?
  loadHanging       Float?
  loadFloor         Float?

  lineDetail  String?
  greeting    String?
  closing     String?
  colorNote   String?
  volumeNote  String?
  excludeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    QuoteTemplateLine[]
  specs    QuoteTemplateSpec[]
  stages   QuoteTemplateStage[]
  payments QuoteTemplatePayment[]

  @@index([buildingType])
}

model QuoteTemplateLine {
  id         String        @id @default(cuid())
  templateId String
  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  partCode String  @default("I")
  partName String  @default("Phần kết cấu thép")
  code     String? // "01"
  name     String
  detail   String? // mô tả riêng; để trống = dùng mô tả chung + vật tư đã gắn
  unit     String? @default("m2")
  note     String?

  // Khác ClientQuoteLine: mẫu KHÔNG giữ qty/amount (đó là số liệu của từng dự án).
  defaultUnitPrice  Float?
  tags              String[] // nhãn loại vật tư (VAT_TU_TAG)
  // Mã "phần" bên báo giá chi tiết dùng để suy đơn giá m². Để trống = luôn nhập tay.
  sourceSectionCode String?
  steelFrameKey     String? // khóa hạng mục bên SteelFrame (xem plan/30)

  sortOrder Int @default(0)

  @@index([templateId])
}

model QuoteTemplateSpec {
  id            String        @id @default(cuid())
  templateId    String
  template      QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  groupCode     String        @default("A") // A | B
  tag           String? // để trống = vật tư dùng chung, luôn in
  name          String
  spec          String?
  origin        String?
  inDescription Boolean       @default(false) // nhắc lại dưới tên hạng mục
  sortOrder     Int           @default(0)

  @@index([templateId])
}

model QuoteTemplateStage {
  id         String        @id @default(cuid())
  templateId String
  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  days       Int?
  sortOrder  Int           @default(0)

  @@index([templateId])
}

model QuoteTemplatePayment {
  id         String        @id @default(cuid())
  templateId String
  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  percent    Float?
  basis      String?
  note       String?
  sortOrder  Int           @default(0)

  @@index([templateId])
}

// ----- Nhật ký thay đổi (audit log) -----

// Ghi lại AI đổi GÌ, LÚC NÀO trên các thực thể liên quan tới tiền.
// Cố ý KHÔNG có khóa ngoại cứng tới Project/User: nhật ký phải sống sót cả khi dự án
// hoặc tài khoản bị xóa — đó mới đúng mục đích truy vết.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String // chụp lại tại thời điểm ghi, để đọc log không cần join
  actorRole   String
  entity      String // Project | Contract | ContractItem | Payment | Quote | WorkPrice
  entityId    String
  entityLabel String? // mô tả ngắn gọn (mã dự án, số HĐ, tên đợt...)
  projectId   String? // để lọc theo dự án; tham chiếu mềm
  action      String // CREATE | UPDATE | DELETE
  // Chỉ những trường THỰC SỰ đổi: { salePrice: { truoc: 1000, sau: 1200 } }
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ===================== THƯ VIỆN DÙNG CHUNG =====================
//
// Một nguồn duy nhất cho cả dự toán chào giá, báo giá gửi khách và dự toán thi công.
// Thay WorkPrice: cùng danh mục công tác, nhưng ĐƠN GIÁ tách ra bảng riêng vì một
// công tác có nhiều giá theo thời điểm và theo khu vực. Sửa giá tại chỗ như bảng cũ
// là mất câu trả lời cho "ngày ký báo giá đó giá bao nhiêu".

// Vùng địa lý phục vụ. Người dùng tự khai (Miền Bắc, Đông Nam Bộ...), không cố định
// 63 tỉnh: giá không chênh theo tỉnh mà chênh theo nhóm nhà cung cấp phục vụ vùng đó.
model KhuVuc {
  id        String   @id @default(cuid())
  ma        String   @unique // MB, MT, DNB...
  ten       String
  ghiChu    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donGia      DonGiaCongTac[]
  nhaCungCap  NhaCungCapKhuVuc[]
  giaMua      GiaMuaVatTu[]
  duAn        Project[]
  baoGia      Quote[]
  dongThiCong EstimateItem[]

  @@index([active, sortOrder])
}

// Danh mục CÔNG TÁC — thay WorkPrice. Giữ nguyên mã (AA.110) vì QuoteItem.workCode
// trỏ vào đây bằng chuỗi (tham chiếu mềm): đổi mã là cắt đứt mọi dòng báo giá đã lập.
model CongTac {
  id         String   @id @default(cuid())
  ma         String   @unique // Mã CV: AA.110
  ten        String
  tenNgan    String? // Loại
  quyCach    String? // TSKT
  donVi      String?
  nhomMa     String   @default("AA") // AA..AL — WORK_GROUP
  // Nhóm chi phí mua hàng (ESTIMATE_GROUP). Đây là CẦU NỐI để đổ dự toán chào giá
  // xuống dự toán thi công: báo giá chia theo đầu việc, mua hàng chia theo thứ phải mua.
  nhomChiPhi String   @default("KHAC")
  heSo       Float? // hệ số gợi ý khi nhập bản giá mới
  ghiChu     String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  donGia      DonGiaCongTac[]
  bienThe     CongTacVatTu[]
  dongBaoGia  QuoteItem[]
  dongMau     BoHangMucDong[]
  dongThiCong EstimateItem[]

  @@index([nhomMa, sortOrder])
  @@index([active])
}

// Một PHIÊN BẢN GIÁ của công tác. Không sửa tại chỗ — đổi giá là thêm dòng mới với
// hieuLucTu mới; dòng mới tự thay dòng cũ theo luật "hiệu lực <= ngày, lấy mới nhất".
//
// Cố ý KHÔNG có hieuLucDen: thêm nó là tạo nguồn sự thật thứ hai cho cùng một việc.
// Công tác ngừng dùng thì tắt CongTac.active.
//
// Hai cột khóa đều cho phép null, và null nghĩa là "áp dụng chung":
//   congTacVatTuId = null -> mọi biến thể vật liệu; khuVucId = null -> toàn quốc.
// Nhờ vậy 135 công tác chuyển từ WorkPrice sang dùng được ngay khi chưa khai vật tư
// hay khu vực nào. Luật chọn dòng nào áp dụng nằm ở src/lib/thuVien/gia.ts.
model DonGiaCongTac {
  id             String        @id @default(cuid())
  congTacId      String
  congTac        CongTac       @relation(fields: [congTacId], references: [id], onDelete: Cascade)
  // Biến thể vật liệu của công tác. null = bản giá áp cho MỌI biến thể.
  congTacVatTuId String?
  bienThe        CongTacVatTu? @relation(fields: [congTacVatTuId], references: [id], onDelete: Cascade)
  khuVucId       String?
  khuVuc         KhuVuc?       @relation(fields: [khuVucId], references: [id], onDelete: SetNull)

  vatTu       Float? // VT
  nhanCongMay Float? // NC_M
  heSo        Float? // HS
  donGia      Float // = (VT + NC_M) * HS — computeBaseCost()

  hieuLucTu     DateTime
  nguon         String   @default("NHAP_TAY") // DON_GIA_NGUON
  ghiChu        String?
  createdAt     DateTime @default(now())
  // Chụp lại người tạo, tham chiếu MỀM — cùng lý lẽ với AuditLog: xóa tài khoản
  // không được phép xóa mất lịch sử giá.
  createdById   String?
  createdByName String?

  dongBaoGia  QuoteItem[]
  dongThiCong EstimateItem[]

  @@index([congTacId, hieuLucTu])
  @@index([congTacId, khuVucId, hieuLucTu])
}

// ----- Nhà cung cấp theo khu vực -----

// Bảng nối TƯỜNG MINH (như ProjectSupplier) chứ không dùng quan hệ nhiều-nhiều ngầm
// của Prisma: cần thêm `uuTien` để biết nhà cung cấp nào được gợi ý trước trong một
// khu vực. Một NCC phục vụ nhiều vùng (Hoa Sen, Hoà Phát bán toàn quốc), và một vùng
// có nhiều NCC — nên bắt chọn một-một là ép người dùng tạo bản ghi trùng.
model NhaCungCapKhuVuc {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  khuVucId   String
  khuVuc     KhuVuc   @relation(fields: [khuVucId], references: [id], onDelete: Cascade)
  uuTien     Int      @default(0) // nhỏ hơn = gợi ý trước
  createdAt  DateTime @default(now())

  @@unique([supplierId, khuVucId])
  @@index([khuVucId, uuTien])
}

// ----- Vật tư -----

// Vật tư master. Phục vụ BA việc cùng lúc, và đó là lý do nó tồn tại thay vì để mỗi
// nơi tự gõ chuỗi:
//   1. nguồn CHỮ cho bảng "Vật liệu áp dụng & TSKT" in kèm báo giá gửi khách;
//   2. thứ phân biệt các biến thể của một công tác (lợp tôn Hoa Sen ≠ lợp tôn Đông Á);
//   3. thứ mang giá MUA theo nhà cung cấp và thời điểm.
model VatTu {
  id          String   @id @default(cuid())
  ma          String   @unique // TON-045-HS
  ten         String
  quyCach     String? // "0,45mm, fy = 2.450 kG/cm2"
  hang        String? // Hoa Sen, Hoà Phát, Đông Á
  xuatXu      String?
  donVi       String?
  nhomTSKT    String   @default("A") // QUOTE_SPEC_GROUP: A | B
  tag         String? // VAT_TU_TAG; null = vật tư dùng chung mọi hạng mục
  inTrongMoTa Boolean  @default(false)
  nhomChiPhi  String   @default("KHAC") // ESTIMATE_GROUP
  ghiChu      String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  congTacLinks CongTacVatTu[]
  giaMua       GiaMuaVatTu[]
  boHangMuc    BoHangMucVatTu[]

  @@index([nhomTSKT, sortOrder])
  @@index([tag])
  @@index([active])
}

// BIẾN THỂ: "công tác X làm bằng vật tư Y". Đây mới là thứ mang đơn giá, không phải
// VatTu trần — cùng một loại tôn, lợp mái và thưng vách là hai đơn giá khác nhau.
model CongTacVatTu {
  id         String  @id @default(cuid())
  congTacId  String
  congTac    CongTac @relation(fields: [congTacId], references: [id], onDelete: Cascade)
  vatTuId    String
  vatTu      VatTu   @relation(fields: [vatTuId], references: [id], onDelete: Cascade)
  tenBienThe String? // đè tên hiển thị; null = ghép "tên công tác + tên vật tư"
  laMacDinh  Boolean @default(false) // biến thể chọn sẵn khi thêm dòng dự toán
  sortOrder  Int     @default(0)

  donGia     DonGiaCongTac[]
  dongBaoGia QuoteItem[]
  dongMau    BoHangMucDong[]

  @@unique([congTacId, vatTuId])
  @@index([vatTuId])
}

// Giá MUA vật tư từ một nhà cung cấp, theo thời điểm.
//
// Cố ý TÁCH khỏi DonGiaCongTac và KHÔNG tự suy ra nhau: giá mua là một SỰ KIỆN về nhà
// cung cấp, còn đơn giá công tác là một QUYẾT ĐỊNH của người lập dự toán (đã chốt là
// đơn giá trọn gói, không bóc định mức). Nối hai thứ bằng công thức sẽ làm giá bán
// nhảy mỗi lần ai đó cập nhật một báo giá vật tư — không ai muốn thế.
model GiaMuaVatTu {
  id         String   @id @default(cuid())
  vatTuId    String
  vatTu      VatTu    @relation(fields: [vatTuId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  khuVucId   String?
  khuVuc     KhuVuc?  @relation(fields: [khuVucId], references: [id], onDelete: SetNull)

  donGia    Float
  donVi     String?
  hieuLucTu DateTime
  nguon     String   @default("NHAP_TAY") // DON_GIA_NGUON
  ghiChu    String?

  createdAt     DateTime @default(now())
  createdById   String?
  createdByName String?

  @@index([vatTuId, hieuLucTu])
  @@index([supplierId, hieuLucTu])
  @@index([khuVucId])
}

// ===================== BỘ HẠNG MỤC CHUẨN =====================
//
// Khung hạng mục theo LOẠI CÔNG TRÌNH: chọn một bộ là có sẵn cây phần/mục và danh
// sách dòng công tác, chỉ còn việc điền khối lượng.
//
// Gộp EstimateTemplate và QuoteTemplate vào MỘT bảng vì chúng mô tả cùng một công
// trình từ hai phía: mẫu dự toán là các dòng CHI PHÍ, mẫu báo giá là các dòng IN CHO
// KHÁCH. Để tách thì thêm một hạng mục phải sửa hai chỗ, và lệch nhau là chuyện sớm
// muộn — đúng cái bệnh mà cả thư viện này sinh ra để chữa.

model BoHangMuc {
  id            String  @id @default(cuid())
  ma            String  @unique
  ten           String
  loaiCongTrinh String? // khớp Project.buildingType, so khớp bỏ dấu/hoa thường
  moTa          String?
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  // --- mặc định cho VĂN BẢN gửi khách (nguyên bộ cột của QuoteTemplate) ---
  vatPercent        Float?  @default(10)
  validDays         Int?    @default(7)
  warrantyMonths    Int?    @default(12)
  maintenanceMonths Int?    @default(120)
  loadRoof          Float?
  loadHanging       Float?
  loadFloor         Float?
  lineDetail        String?
  greeting          String?
  closing           String?
  colorNote         String?
  volumeNote        String?
  excludeNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phan      BoHangMucPhan[]
  dong      BoHangMucDong[]
  vatLieu   BoHangMucVatTu[]
  giaiDoan  BoHangMucGiaiDoan[]
  thanhToan BoHangMucThanhToan[]

  @@index([loaiCongTrinh])
  @@index([active, sortOrder])
}

// Một "phần" của bộ — đồng thời là khuôn QuoteSection (nội bộ) VÀ khuôn
// ClientQuoteLine (gửi khách). Một dòng, hai mặt: hết cảnh `sourceSectionCode` trỏ
// bằng chuỗi giữa hai bảng mẫu rời nhau.
model BoHangMucPhan {
  id          String    @id @default(cuid())
  boHangMucId String
  boHangMuc   BoHangMuc @relation(fields: [boHangMucId], references: [id], onDelete: Cascade)

  ma        String // "A" / "I"
  ten       String
  loai      String          @default("PHAN") // PHAN | SUB
  parentId  String?
  parent    BoHangMucPhan?  @relation("CayPhan", fields: [parentId], references: [id], onDelete: Cascade)
  children  BoHangMucPhan[] @relation("CayPhan")
  sortOrder Int             @default(0)

  // --- mặt gửi khách ---
  // false = phần này chỉ để tính giá vốn, không lên bản gửi khách.
  inChoKhach    Boolean  @default(true)
  partCode      String   @default("I")
  partName      String   @default("Phần kết cấu thép")
  maKhach       String? // "01"
  tenKhachHang  String? // tên dài in cho khách; null = dùng `ten`
  moTaKhachHang String? // gạch đầu dòng
  donViKhach    String?  @default("m2")
  donGiaKhach   Float? // đơn giá m² mặc định; null = suy từ giá vốn của phần
  ghiChuKhach   String?
  tags          String[] // VAT_TU_TAG
  steelFrameKey String?

  dong BoHangMucDong[]

  @@unique([boHangMucId, ma])
  @@index([parentId])
}

// Dòng công tác trong khuôn.
//
// GIỮ NGUYÊN bốn cột tham số của EstimateTemplateLine (vaiTro/napThamSo/layTuThamSo/
// heSoQuyDoi) — đó chính là lý do `computeTemplateLines` dùng lại được không sửa một
// dòng nào. Cơ chế: dòng INPUT nạp khối lượng vào một tham số, dòng DERIVED lấy khối
// lượng = tham số × hệ số.
model BoHangMucDong {
  id          String         @id @default(cuid())
  boHangMucId String
  boHangMuc   BoHangMuc      @relation(fields: [boHangMucId], references: [id], onDelete: Cascade)
  phanId      String?
  phan        BoHangMucPhan? @relation(fields: [phanId], references: [id], onDelete: SetNull)

  congTacId      String?
  congTac        CongTac?      @relation(fields: [congTacId], references: [id], onDelete: SetNull)
  congTacVatTuId String?
  bienThe        CongTacVatTu? @relation(fields: [congTacVatTuId], references: [id], onDelete: SetNull)
  // Chụp lại mã công tác để bộ khung còn đọc được khi công tác bị xóa khỏi thư viện.
  maCongTac      String?

  ten              String
  donVi            String?
  donGiaMacDinh    Float?
  khoiLuongMacDinh Float?
  groupLabel       String? // nhãn nhóm cấp 2 phía dự toán thi công
  nhomChiPhi       String  @default("KHAC") // ESTIMATE_GROUP
  ghiChu           String?
  sortOrder        Int     @default(0)

  // --- engine tham số ---
  vaiTro      String  @default("INPUT") // INPUT | DERIVED
  napThamSo   String?
  layTuThamSo String?
  heSoQuyDoi  Float?  @default(1)

  @@index([boHangMucId, sortOrder])
  @@index([phanId])
  @@index([congTacId])
}

// Bảng "Vật liệu áp dụng & TSKT" của bộ — trỏ vào VatTu master thay vì gõ lại chữ.
// Đây là chỗ đơn giản hoá thật sự: trước đây mỗi mẫu báo giá tự giữ 16 dòng chữ
// riêng, sửa quy cách tôn phải sửa từng mẫu một.
model BoHangMucVatTu {
  id          String    @id @default(cuid())
  boHangMucId String
  boHangMuc   BoHangMuc @relation(fields: [boHangMucId], references: [id], onDelete: Cascade)
  vatTuId     String
  vatTu       VatTu     @relation(fields: [vatTuId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@unique([boHangMucId, vatTuId])
  @@index([boHangMucId, sortOrder])
}

model BoHangMucGiaiDoan {
  id          String    @id @default(cuid())
  boHangMucId String
  boHangMuc   BoHangMuc @relation(fields: [boHangMucId], references: [id], onDelete: Cascade)
  ten         String
  soNgay      Int?
  sortOrder   Int       @default(0)

  @@index([boHangMucId, sortOrder])
}

model BoHangMucThanhToan {
  id          String    @id @default(cuid())
  boHangMucId String
  boHangMuc   BoHangMuc @relation(fields: [boHangMucId], references: [id], onDelete: Cascade)
  nhan        String
  phanTram    Float?
  canCu       String?
  ghiChu      String?
  sortOrder   Int       @default(0)

  @@index([boHangMucId, sortOrder])
}
